# Copy to config.toml and fill in the values. Only telegram_bot_token,
# telegram_allowed_user_id, agent_workspace_dir, and model are required.
# The rest have defaults. The opencode server is managed internally: the
# binary starts it on a loopback port with a generated password, so no
# serve credentials live here.
telegram_bot_token = "123456:replace-me"
telegram_allowed_user_id = 123456789
agent_workspace_dir = "/Users/YOU/agent-workspace"

# Optional. Defaults shown.
agent_timeout_ms = 300000

# Required default model for new sessions. Only OpenCode Zen models are
# allowed, written bare with an optional "#variant" thinking effort. The
# session keeps it until /model overrides it.
model = "deepseek-v4.1-flash-free"
model_variant = "high"
